# Chat providers. Supply only the providers you want to expose in the UI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional remote RAG provider. Local in-memory RAG works without these values.
UPSTASH_VECTOR_REST_URL="https://destined-boxer-94661-eu1-vector.upstash.io"
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_REDIS_REST_URL="https://dear-liger-113998.upstash.io"
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_URL_SRC=
UPSTASH_REDIS_REST_TOKEN_SRC=
UPSTASH_REDIS_REST_URL_DST=
UPSTASH_REDIS_REST_TOKEN_DST=
UPSTASH_VECTOR_NAMESPACE=genius-rag

# Internal services, persistent model cache, and index state.
RAG_API_URL=http://rag-api:8000
DATABASE_URL=file:/data/genius.sqlite
LEARNINGS_ROOT=/workspace/learnings
MODEL_CACHE_DIR=/models
# Stores the managed Upstash chunk manifest used to delete stale vectors safely.
LOCAL_INDEX_DIR=/data/index
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_CHUNK_TOKENS=700
RAG_CHUNK_OVERLAP_TOKENS=100
